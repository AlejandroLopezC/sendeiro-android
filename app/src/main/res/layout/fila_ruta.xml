<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp">
    <TextView android:id="@+id/nombreRuta" android:layout_width="0dp" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/etiquetaCerrada" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/etiquetaCerrada" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/estado_cerrada" android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/datosRuta" android:layout_width="0dp" android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/nombreRuta" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <Button android:id="@+id/botonDetalle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ver detalle"
        app:layout_constraintTop_toBottomOf="@id/datosRuta" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
